<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="color-scheme" content="dark light">
<title>Catch of the Day</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  /* ================= palette ================= */
  /* NIGHT — a floodlit sky, warm paper, and the pink of a Saturday sports paper */
  :root {
    --ink: #141530;
    --ink-raised: #1d1e40;
    --ink-sunk: #0f1026;
    --paper: #f6f3ec;
    --paper-dim: #a9a6c4;
    --paper-faint: #74719a;
    --rule: #2b2c55;
    --rule-bright: #43447a;
    --pink: #ff3d8b;
    --pink-soft: #ff77b0;
    --on-pink: #24061a;
    --cricket: #ff7a45;
    --f1: #9a7bff;
    --football: #2fd36f;
    --tennis: #ecdf2f;
    --shadow: rgba(4, 4, 22, .55);

    --rail: 3.9rem;
    --gap: 1.35rem;
    --maxw: 44rem;

    --f-display: "Barlow Condensed", "Arial Narrow", system-ui, sans-serif;
    --f-head: "Fraunces", Georgia, "Times New Roman", serif;
    --f-body: "Barlow", system-ui, -apple-system, "Segoe UI", sans-serif;
    --f-mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
  }
  /* DAY — faint pink newsprint, dark ink */
  :root[data-theme="day"] {
    --ink: #fbf3f1;
    --ink-raised: #fffaf8;
    --ink-sunk: #f2e7e3;
    --paper: #1a1424;
    --paper-dim: #5c5570;
    --paper-faint: #8f8aa0;
    --rule: #e8dcd8;
    --rule-bright: #d6c8c4;
    --pink: #de1b6f;
    --pink-soft: #b81a5e;
    --on-pink: #ffffff;
    --cricket: #c8501f;
    --f1: #6742cc;
    --football: #1c9b51;
    --tennis: #8a7f10;
    --shadow: rgba(70, 40, 55, .16);
  }

  * { box-sizing: border-box; min-width: 0; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    margin: 0;
    overflow-x: hidden;
    background: var(--ink);
    color: var(--paper);
    font: 400 16px/1.6 var(--f-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  /* breathing floodlight glow */
  body::before {
    content: "";
    position: fixed;
    inset: -20% -20% auto -20%;
    height: 60vh;
    background: radial-gradient(70% 100% at 50% 0%,
      color-mix(in srgb, var(--pink) 16%, transparent), transparent 72%);
    pointer-events: none;
    z-index: 0;
    animation: breathe 11s ease-in-out infinite alternate;
  }
  @keyframes breathe { from { opacity: .45; } to { opacity: 1; } }

  a { color: inherit; }
  ::selection { background: var(--pink); color: var(--on-pink); }
  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .skip {
    position: absolute; left: 1rem; top: -3rem; z-index: 60;
    padding: .5rem .8rem; background: var(--pink); color: var(--on-pink);
    font-family: var(--f-display); font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; font-size: .8rem; text-decoration: none;
    transition: top .15s;
  }
  .skip:focus { top: 1rem; }

  /* scroll progress — how deep into the day's play you are */
  .progress {
    position: fixed; left: 0; top: 0; height: 3px; width: 100%;
    transform: scaleX(0); transform-origin: left; z-index: 50;
    background: linear-gradient(90deg, var(--pink), var(--pink-soft));
    transition: transform .1s linear;
  }

  .shell { position: relative; z-index: 1; max-width: var(--maxw); margin: 0 auto; padding: 0 1.15rem 6rem; }

  /* ================= masthead ================= */
  .masthead {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 1rem; padding: 2.6rem 0 1rem;
  }
  .wordmark {
    margin: 0;
    font-family: var(--f-display); font-weight: 700;
    font-size: clamp(2.1rem, 8vw, 3.6rem);
    line-height: .86; letter-spacing: .01em; text-transform: uppercase;
  }
  .wordmark .of {
    display: block; margin-top: .55em; padding-left: .1em;
    font-size: clamp(.62rem, 1.7vw, .8rem); font-weight: 600;
    letter-spacing: .26em; color: var(--pink); text-transform: uppercase;
  }
  .clock {
    font-family: var(--f-mono); font-weight: 500; font-size: .95rem;
    color: var(--pink); letter-spacing: .04em; white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .ledger {
    display: flex; flex-wrap: wrap; gap: .35rem 1rem;
    font-family: var(--f-mono); font-size: .74rem; color: var(--paper-faint);
    letter-spacing: .02em; padding-bottom: 1.1rem;
    border-bottom: 2px solid var(--rule-bright);
  }
  .ledger .lit { color: var(--pink); }
  #new-jump {
    font: inherit; color: var(--pink); background: none; border: 0; padding: 0;
    cursor: pointer; letter-spacing: inherit;
  }
  #new-jump:hover { text-decoration: underline; text-underline-offset: 3px; }
  #new-jump .lit { font-weight: 600; }

  .warn {
    margin: 1rem 0 0; padding: .55rem .8rem;
    border-left: 3px solid var(--cricket); background: var(--ink-raised);
    color: var(--paper-dim); font-size: .82rem;
  }

  /* ================= filter tabs ================= */
  .filters {
    position: sticky; top: 0; z-index: 20;
    display: flex; flex-wrap: wrap; gap: .1rem .3rem;
    margin: 0 -1.15rem; padding: .7rem 1.15rem;
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .filters button {
    font-family: var(--f-display); font-weight: 600; font-size: .84rem;
    text-transform: uppercase; letter-spacing: .07em; color: var(--paper-dim);
    background: none; border: 0; padding: .4rem .55rem .34rem; cursor: pointer;
    border-bottom: 2px solid transparent; transition: color .12s;
  }
  .filters button:hover { color: var(--paper); }
  .filters button[aria-pressed="true"] { color: var(--paper); border-bottom-color: var(--pink); }
  .filters button .tally {
    font-family: var(--f-mono); font-weight: 400; font-size: .68rem;
    letter-spacing: 0; color: var(--paper-faint); margin-left: .3em;
  }
  .filters button[data-sport="cricket"][aria-pressed="true"] { border-bottom-color: var(--cricket); }
  .filters button[data-sport="f1"][aria-pressed="true"] { border-bottom-color: var(--f1); }
  .filters button[data-sport="football"][aria-pressed="true"] { border-bottom-color: var(--football); }
  .filters button[data-sport="tennis"][aria-pressed="true"] { border-bottom-color: var(--tennis); }
  .theme-toggle {
    margin-left: auto;
    font-family: var(--f-display); font-weight: 600; font-size: .72rem;
    letter-spacing: .12em; text-transform: uppercase; color: var(--paper-faint);
    background: none; border: 0; padding: .4rem .2rem; cursor: pointer;
  }
  .theme-toggle:hover { color: var(--paper); }

  /* ================= featured: the catch of the day ================= */
  .hero {
    margin: 2rem 0 .5rem;
    padding: 1.5rem 1.6rem 1.6rem;
    border: 1px solid var(--rule-bright);
    border-left: 4px solid var(--pink);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--pink) 9%, transparent), transparent 55%),
      var(--ink-raised);
    box-shadow: 0 20px 44px -28px var(--shadow);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .hero:hover { transform: translateY(-2px); box-shadow: 0 26px 52px -26px var(--shadow); }
  .hero .kicker {
    display: flex; align-items: center; gap: .55rem;
    font-family: var(--f-display); font-weight: 700; font-size: .74rem;
    letter-spacing: .16em; text-transform: uppercase; color: var(--pink);
    margin-bottom: .6rem;
  }
  .hero .kicker::after {
    content: ""; flex: 1; height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--pink) 55%, transparent), transparent);
  }
  .hero .h-meta {
    font-family: var(--f-display); font-weight: 600; font-size: .72rem;
    letter-spacing: .08em; text-transform: uppercase; color: var(--paper-faint);
    margin-bottom: .4rem;
  }
  .hero .h-meta .sport { color: var(--paper-dim); }
  .hero[data-sport="cricket"] .h-meta .sport { color: var(--cricket); }
  .hero[data-sport="f1"] .h-meta .sport { color: var(--f1); }
  .hero[data-sport="football"] .h-meta .sport { color: var(--football); }
  .hero[data-sport="tennis"] .h-meta .sport { color: var(--tennis); }
  .hero h2 {
    margin: 0 0 .5rem;
    font-family: var(--f-head); font-optical-sizing: auto; font-weight: 500;
    font-size: clamp(1.4rem, 3.6vw, 2rem); line-height: 1.22; letter-spacing: -.012em;
  }
  .hero h2 a { text-decoration: none; }
  .hero h2 a:hover { color: var(--pink); }
  .hero p { margin: 0; color: var(--paper-dim); font-size: .98rem; line-height: 1.55; }

  /* ================= day of play — chapter break ================= */
  .day { margin-top: 3.4rem; }
  main > .day:first-of-type { margin-top: 2rem; }
  .day-head {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: .1rem .7rem;
    padding-bottom: .35rem; margin-bottom: .5rem;
    border-bottom: 3px solid var(--pink);
  }
  .day-head .wk {
    font-family: var(--f-display); font-weight: 700;
    font-size: clamp(1.9rem, 6vw, 3rem); line-height: .95;
    text-transform: uppercase; letter-spacing: .01em;
  }
  .day-head .dt {
    font-family: var(--f-display); font-weight: 600;
    font-size: clamp(.95rem, 2.4vw, 1.2rem); letter-spacing: .12em;
    text-transform: uppercase; color: var(--paper-dim);
  }
  .day-head .today {
    align-self: center; font-family: var(--f-mono); font-size: .6rem;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--on-pink); background: var(--pink);
    padding: .18em .5em; border-radius: 2px;
  }
  .day-head .n {
    margin-left: auto; align-self: baseline;
    font-family: var(--f-mono); font-size: 1.05rem; color: var(--paper-dim);
    font-variant-numeric: tabular-nums;
  }
  .day-head .n .oftotal { color: var(--paper-faint); font-size: .8rem; }

  /* ================= the spine + entries ================= */
  .entries { position: relative; list-style: none; margin: 0; padding: 0; }
  .entries::before {
    content: ""; position: absolute; left: var(--rail); top: 0; bottom: 0;
    width: 2px; background: var(--rule-bright);
    transform: scaleY(var(--spine, 1)); transform-origin: top;
    transition: transform .6s cubic-bezier(.2, .8, .2, 1);
  }

  .entry {
    position: relative; padding: .95rem 0 .95rem calc(var(--rail) + var(--gap));
    min-height: 3rem;
  }
  .entry + .entry { border-top: 1px solid var(--rule); }
  .entry.is-hidden { display: none; }

  .js .entry { opacity: 0; transform: translateY(12px); transition: opacity .5s ease, transform .5s ease, background-color .15s ease; }
  .js .entry.seen { opacity: 1; transform: none; }

  .entry .time {
    position: absolute; left: 0; top: 1.05rem; width: calc(var(--rail) - .7rem);
    text-align: right; font-family: var(--f-mono); font-weight: 500;
    font-size: .76rem; color: var(--paper-dim); font-variant-numeric: tabular-nums;
  }
  .entry .lane {
    position: absolute; left: calc(var(--rail) - 1px); top: 0; bottom: 0;
    width: 3px; background: var(--paper-faint); transition: width .15s ease;
  }
  .entry[data-sport="cricket"] .lane { background: var(--cricket); }
  .entry[data-sport="f1"] .lane { background: var(--f1); }
  .entry[data-sport="football"] .lane { background: var(--football); }
  .entry[data-sport="tennis"] .lane { background: var(--tennis); }

  .entry .node {
    position: absolute; left: calc(var(--rail) - 4px); top: 1.15rem;
    width: 9px; height: 9px; border-radius: 50%; background: var(--pink);
    box-shadow: 0 0 0 3px var(--ink), 0 0 12px 1px color-mix(in srgb, var(--pink) 70%, transparent);
    display: none;
  }
  .entry.is-new .node { display: block; animation: ping 2.4s ease-out infinite; }
  .entry.is-new .time { color: var(--pink); }
  @keyframes ping {
    0%, 60% { box-shadow: 0 0 0 3px var(--ink), 0 0 0 0 color-mix(in srgb, var(--pink) 55%, transparent); }
    100% { box-shadow: 0 0 0 3px var(--ink), 0 0 0 9px transparent; }
  }

  .entry .label {
    font-family: var(--f-display); font-weight: 600; font-size: .7rem;
    text-transform: uppercase; letter-spacing: .09em; color: var(--paper-faint);
    margin-bottom: .2rem;
  }
  .entry .label .sport { color: var(--paper-dim); }
  .entry[data-sport="cricket"] .label .sport { color: var(--cricket); }
  .entry[data-sport="f1"] .label .sport { color: var(--f1); }
  .entry[data-sport="football"] .label .sport { color: var(--football); }
  .entry[data-sport="tennis"] .label .sport { color: var(--tennis); }

  .entry .headline {
    margin: 0 0 .3rem;
    font-family: var(--f-head); font-optical-sizing: auto; font-weight: 460;
    font-size: 1.075rem; line-height: 1.33; letter-spacing: -.004em;
  }
  .entry .headline a {
    text-decoration: none;
    background-image: linear-gradient(var(--pink), var(--pink));
    background-size: 0% 2px; background-position: 0 100%; background-repeat: no-repeat;
    transition: background-size .25s ease, color .15s ease;
  }
  .entry:hover .headline a, .entry.is-cursor .headline a { color: var(--pink); background-size: 100% 2px; }
  .entry:hover .lane, .entry.is-cursor .lane { width: 6px; }

  .entry .dek {
    margin: 0; font-size: .9rem; line-height: 1.5; color: var(--paper-dim);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
    line-clamp: 2; overflow: hidden;
  }
  .entry .dek.stub { font-style: italic; color: var(--paper-faint); }
  .headline, .dek { overflow-wrap: anywhere; }

  .entry[data-sport="cricket"]:hover { background: color-mix(in srgb, var(--cricket) 7%, transparent); }
  .entry[data-sport="f1"]:hover { background: color-mix(in srgb, var(--f1) 8%, transparent); }
  .entry[data-sport="football"]:hover { background: color-mix(in srgb, var(--football) 7%, transparent); }
  .entry[data-sport="tennis"]:hover { background: color-mix(in srgb, var(--tennis) 8%, transparent); }

  .day.is-empty { display: none; }

  /* ================= earlier fold ================= */
  .earlier { margin-top: 3rem; }
  .earlier > summary {
    font-family: var(--f-display); font-weight: 600; font-size: .95rem;
    text-transform: uppercase; letter-spacing: .12em; color: var(--paper-dim);
    cursor: pointer; padding: .85rem 0; border-top: 2px solid var(--rule-bright);
    list-style: none;
  }
  .earlier > summary::-webkit-details-marker { display: none; }
  .earlier > summary::after { content: " ▾"; color: var(--paper-faint); }
  .earlier[open] > summary::after { content: " ▴"; }
  .earlier > summary .tally { font-family: var(--f-mono); font-weight: 400; letter-spacing: 0; color: var(--paper-faint); }

  /* ================= footer ================= */
  .foot {
    margin-top: 4rem; padding-top: 1.2rem; border-top: 1px solid var(--rule);
    font-family: var(--f-mono); font-size: .74rem; line-height: 1.7; color: var(--paper-faint);
  }
  .foot details { margin-top: .5rem; }
  .foot summary { cursor: pointer; color: var(--paper-dim); }
  .foot .sources { list-style: none; margin: .5rem 0 0; padding: 0; }
  .foot .sources li { padding: .12rem 0; }
  .foot .sources .down { color: var(--cricket); }

  .empty {
    padding: 3rem 0; text-align: center; font-family: var(--f-display);
    font-size: 1rem; letter-spacing: .1em; text-transform: uppercase; color: var(--paper-faint);
  }

  /* ================= shortcuts ================= */
  .kbd-hint {
    position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 40;
    width: 2rem; height: 2rem; border-radius: 50%;
    border: 1px solid var(--rule-bright); background: var(--ink-raised);
    color: var(--paper-dim); font-family: var(--f-mono); font-size: .9rem; cursor: pointer;
  }
  .kbd-hint:hover { color: var(--paper); border-color: var(--pink); }
  .kbd-panel {
    position: fixed; right: 1.1rem; bottom: 3.6rem; z-index: 40; width: 15rem;
    padding: .9rem 1rem; background: var(--ink-raised);
    border: 1px solid var(--rule-bright); box-shadow: 0 12px 32px var(--shadow);
    font-family: var(--f-mono); font-size: .74rem; color: var(--paper-dim);
  }
  .kbd-panel b {
    display: block; font-family: var(--f-display); font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; color: var(--paper-faint); margin-bottom: .5rem;
  }
  .kbd-panel dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: .3rem .8rem; }
  .kbd-panel dt { color: var(--pink); white-space: nowrap; }
  .kbd-panel dd { margin: 0; }
  @media (hover: none) { .kbd-hint, .kbd-panel { display: none; } }

  @media (max-width: 560px) {
    :root { --rail: 3.3rem; --gap: 1rem; }
    .shell { padding: 0 .9rem 5rem; }
    .filters { margin: 0 -.9rem; padding: .6rem .9rem; }
    .hero { padding: 1.2rem 1.1rem 1.3rem; }
    .entry .time { font-size: .68rem; }
    .entry::before { inset: 0 -.9rem 0 calc(var(--rail) - 1px); }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    body::before { animation: none; }
    .entries::before { transition: none !important; }
    .js .entry { opacity: 1; transform: none; transition: none; }
    .entry.is-new .node { animation: none; }
    .progress { transition: none; }
  }
</style>
</head>
<body>
<a class="skip" href="#feed">Skip to the feed</a>
<div class="progress" id="progress" aria-hidden="true"></div>
<div class="shell">

  <header class="masthead">
    <h1 class="wordmark">Catch of the Day<span class="of">The pick of the day’s play</span></h1>
    <time class="clock" id="clock" datetime="{{ generated_at }}">--:--:--</time>
  </header>

  <div class="ledger">
    <span><span class="lit" id="filed">{{ total }}</span> filed · {{ statuses|length }} sources</span>
    <button type="button" id="new-jump" hidden><span class="lit" id="new-count">0</span> new since your last visit ↓</button>
    <span>rebuilt 07:00 &amp; 19:00 IST · last <span id="built">{{ generated_at[11:16] }} UTC</span></span>
  </div>
  {% if broken %}
  <p class="warn">{{ broken|length }} source{{ '' if broken|length == 1 else 's' }} didn’t report this run — listed at the foot of the page.</p>
  {% endif %}

  <nav class="filters" id="filters" aria-label="Filter by discipline">
    <button data-sport="all" aria-pressed="true">All<span class="tally">{{ total }}</span></button>
    {% for s in sports %}
    <button data-sport="{{ s }}" aria-pressed="false">{{ sport_labels[s] }}<span class="tally">{{ counts[s] }}</span></button>
    {% endfor %}
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch day / night">Night</button>
  </nav>

  {% if featured %}
  <article class="hero" data-sport="{{ featured.item.sport }}">
    <div class="kicker">The catch of the day</div>
    <div class="h-meta"><span class="sport">{{ sport_labels.get(featured.item.sport, featured.item.sport) }}</span> · {{ featured.item.source_name }} · {{ featured.time }}</div>
    <h2><a href="{{ featured.item.url }}" target="_blank" rel="noopener noreferrer">{{ featured.item.title }}</a></h2>
    <p>{{ featured.item.summary }}</p>
  </article>
  {% endif %}

  <main id="feed" tabindex="-1">
  {% if not days %}
  <p class="empty">No play today</p>
  {% endif %}

  {% for day in days %}
  {% if loop.index0 == recent_open and days|length > recent_open %}
  <details class="earlier" id="earlier">
    <summary>Earlier play <span class="tally">{{ days[recent_open:]|sum(attribute='count') }} items</span></summary>
  {% endif %}

  <section class="day" data-day="{{ day.key }}" data-count="{{ day.count }}">
    <div class="day-head">
      <span class="wk">{{ day.weekday }}</span>
      <span class="dt">{{ day.date_label }}</span>
      {% if day.key == today_key %}<span class="today">Today</span>{% endif %}
      <span class="n"><b class="shown">{{ day.count }}</b><span class="oftotal" data-total="{{ day.count }}"></span></span>
    </div>
    <ul class="entries">
      {% for e in day.entries %}
      <li class="entry" data-sport="{{ e.item.sport }}" data-fetched="{{ e.item.fetched_at }}" data-published="{{ e.item.published_at }}">
        <span class="time">{{ e.time }}</span>
        <span class="lane" aria-hidden="true"></span>
        <span class="node" aria-hidden="true"></span>
        <div class="label"><span class="sport">{{ sport_labels.get(e.item.sport, e.item.sport) }}</span> · {{ e.item.source_name }}</div>
        <h2 class="headline"><a href="{{ e.item.url }}" target="_blank" rel="noopener noreferrer">{{ e.item.title }}</a></h2>
        {% if e.item.summary %}
        <p class="dek">{{ e.item.summary }}</p>
        {% else %}
        <p class="dek stub">Filed without a summary — open the report.</p>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
  {% if days|length > recent_open %}
  </details>
  {% endif %}
  </main>

  <footer class="foot">
    <p>Catch of the Day — a personal reading table for cricket, Formula 1, football
       and tennis writing. Every headline links to the original publisher.</p>
    <details>
      <summary>{{ statuses|selectattr('ok')|list|length }} of {{ statuses|length }} sources reporting</summary>
      <ul class="sources">
        {% for s in statuses %}
        <li class="{{ 'down' if not s.ok else '' }}">
          {{ '·' if s.ok else '×' }} {{ s.name }} — {{ s.detail }}{% if s.ok and s.entries %} · {{ s.entries }} in feed{% endif %}
        </li>
        {% endfor %}
      </ul>
    </details>
  </footer>
</div>

<button type="button" class="kbd-hint" id="kbd-hint" aria-label="Keyboard shortcuts" aria-expanded="false">?</button>
<div class="kbd-panel" id="kbd-panel" role="dialog" aria-label="Keyboard shortcuts" hidden>
  <b>Keyboard</b>
  <dl>
    <dt>j / k</dt><dd>next / previous</dd>
    <dt>o</dt><dd>open article</dd>
    <dt>1–5</dt><dd>All · Cricket · F1 · Football · Tennis</dd>
    <dt>g / G</dt><dd>top / bottom</dd>
    <dt>t</dt><dd>day / night</dd>
    <dt>?</dt><dd>this panel</dd>
  </dl>
</div>

<script>
(function () {
  "use strict";
  var K_VISIT = "sportsfeed.lastVisit";
  var K_FILTER = "sportsfeed.filter";
  var K_THEME = "sportsfeed.theme";
  var root = document.documentElement;
  root.classList.add("js");
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---- theme ---- */
  var toggle = document.getElementById("theme-toggle");
  function readTheme() { try { return localStorage.getItem(K_THEME); } catch (e) { return null; } }
  function paint(theme) {
    if (theme === "day") root.setAttribute("data-theme", "day");
    else root.removeAttribute("data-theme");
    toggle.textContent = theme === "day" ? "Day" : "Night";
  }
  var saved = readTheme();
  if (!saved) saved = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "day" : "night";
  paint(saved);
  toggle.addEventListener("click", function () {
    saved = root.hasAttribute("data-theme") ? "night" : "day";
    paint(saved);
    try { localStorage.setItem(K_THEME, saved); } catch (e) {}
  });

  /* ---- session clock ---- */
  var clockEl = document.getElementById("clock");
  function tick() {
    var d = new Date(), p = function (n) { return String(n).padStart(2, "0"); };
    clockEl.textContent = p(d.getHours()) + ":" + p(d.getMinutes()) + ":" + p(d.getSeconds());
  }
  tick();
  setInterval(tick, 1000);

  /* ---- localise the "last built" stamp ---- */
  try {
    var built = document.getElementById("built");
    var b = new Date("{{ generated_at }}");
    var mins = Math.round((Date.now() - b) / 60000);
    built.textContent = mins < 60 ? mins + " min ago"
      : mins < 1440 ? Math.round(mins / 60) + " h ago" : Math.round(mins / 1440) + " d ago";
  } catch (e) {}

  /* ---- new since last visit ---- */
  var entries = Array.prototype.slice.call(document.querySelectorAll(".entry"));
  var lastVisit = 0;
  try { lastVisit = parseInt(localStorage.getItem(K_VISIT) || "0", 10) || 0; } catch (e) {}
  var newCount = 0, newInEarlier = false;
  var earlier = document.getElementById("earlier");
  entries.forEach(function (el) {
    var seen = Date.parse(el.getAttribute("data-fetched"));
    if (lastVisit && seen && seen > lastVisit) {
      el.classList.add("is-new");
      newCount++;
      if (earlier && earlier.contains(el)) newInEarlier = true;
    }
  });
  if (newCount) {
    document.getElementById("new-count").textContent = newCount;
    document.getElementById("new-tally").hidden = false;
    if (newInEarlier && earlier) earlier.open = true;
  }
  try { localStorage.setItem(K_VISIT, String(Date.now())); } catch (e) {}

  var firstNew = document.querySelector(".entry.is-new");
  function revealEntry(el) {
    if (!el) return;
    if (earlier && earlier.contains(el)) earlier.open = true;
    el.classList.add("seen");
    el.scrollIntoView({ block: "center", behavior: reduce ? "auto" : "smooth" });
  }
  document.getElementById("new-jump").addEventListener("click", function () {
    var target = document.querySelector(".entry.is-new:not(.is-hidden)") || firstNew;
    revealEntry(target);
    setCursor(target);
  });

  /* ---- filter by discipline (buttons, URL hash, keys 1–5) ---- */
  var nav = document.getElementById("filters");
  var buttons = Array.prototype.slice.call(nav.querySelectorAll("button[data-sport]"));
  var days = Array.prototype.slice.call(document.querySelectorAll(".day"));
  var SPORTS = buttons.map(function (b) { return b.dataset.sport; });
  var BASE_TITLE = document.title;
  var cursorIndex = -1;

  function apply(sport, fromHash) {
    if (SPORTS.indexOf(sport) < 0) sport = "all";
    buttons.forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.sport === sport)); });
    entries.forEach(function (el) {
      var show = sport === "all" || el.getAttribute("data-sport") === sport;
      el.classList.toggle("is-hidden", !show);
    });
    days.forEach(function (d) {
      var shown = d.querySelectorAll(".entry:not(.is-hidden)").length;
      d.classList.toggle("is-empty", shown === 0);
      d.querySelector(".day-head .shown").textContent = shown;
      var ot = d.querySelector(".day-head .oftotal");
      ot.textContent = sport === "all" ? "" : " / " + ot.getAttribute("data-total");
    });
    var label = sport === "all" ? "" : buttons.filter(function (b) {
      return b.dataset.sport === sport;
    })[0].firstChild.textContent.trim();
    document.title = label ? label + " · " + BASE_TITLE : BASE_TITLE;
    try { localStorage.setItem(K_FILTER, sport); } catch (e) {}
    if (!fromHash) {
      history.replaceState(null, "", sport === "all" ? location.pathname + location.search : "#" + sport);
    }
    cursorIndex = -1;
    document.querySelectorAll(".entry.is-cursor").forEach(function (el) { el.classList.remove("is-cursor"); });
  }

  nav.addEventListener("click", function (e) {
    var btn = e.target.closest("button[data-sport]");
    if (btn) apply(btn.dataset.sport);
  });
  window.addEventListener("hashchange", function () {
    apply((location.hash || "").replace("#", "") || "all", true);
  });

  var hash = (location.hash || "").replace("#", "");
  if (SPORTS.indexOf(hash) > -1) {
    apply(hash, true);
  } else {
    var stored = "all";
    try { stored = localStorage.getItem(K_FILTER) || "all"; } catch (e) {}
    if (stored !== "all") apply(stored);
  }

  /* ---- keyboard navigation ---- */
  function visibleEntries() {
    return entries.filter(function (el) { return !el.classList.contains("is-hidden"); });
  }
  function setCursor(el) {
    var i = visibleEntries().indexOf(el);
    if (i < 0) return;
    document.querySelectorAll(".entry.is-cursor").forEach(function (e) { e.classList.remove("is-cursor"); });
    el.classList.add("is-cursor");
    cursorIndex = i;
  }
  function moveCursor(delta) {
    var list = visibleEntries();
    if (!list.length) return;
    cursorIndex = cursorIndex < 0 ? (delta > 0 ? 0 : list.length - 1)
      : Math.min(list.length - 1, Math.max(0, cursorIndex + delta));
    var el = list[cursorIndex];
    document.querySelectorAll(".entry.is-cursor").forEach(function (e) { e.classList.remove("is-cursor"); });
    el.classList.add("is-cursor");
    revealEntry(el);
  }

  var hint = document.getElementById("kbd-hint");
  var panel = document.getElementById("kbd-panel");
  function togglePanel(force) {
    var open = force === undefined ? panel.hidden : force;
    panel.hidden = !open;
    hint.setAttribute("aria-expanded", String(open));
  }
  hint.addEventListener("click", function () { togglePanel(); });

  document.addEventListener("keydown", function (e) {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    var tag = (document.activeElement && document.activeElement.tagName) || "";
    if (tag === "INPUT" || tag === "TEXTAREA") return;
    switch (e.key) {
      case "j": case "ArrowDown": e.preventDefault(); moveCursor(1); break;
      case "k": case "ArrowUp": e.preventDefault(); moveCursor(-1); break;
      case "o": {
        var el = visibleEntries()[cursorIndex];
        if (el) { e.preventDefault(); window.open(el.querySelector(".headline a").href, "_blank", "noopener"); }
        break;
      }
      case "g": window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" }); break;
      case "G": window.scrollTo({ top: document.body.scrollHeight, behavior: reduce ? "auto" : "smooth" }); break;
      case "t": toggle.click(); break;
      case "?": togglePanel(); break;
      case "Escape": togglePanel(false); break;
      case "1": case "2": case "3": case "4": case "5": {
        var s = SPORTS[parseInt(e.key, 10) - 1];
        if (s) { apply(s); var f = buttons.filter(function (b) { return b.dataset.sport === s; })[0]; f && f.focus(); }
        break;
      }
    }
  });

  /* ---- scroll: progress bar + reveal entries + draw spines ---- */
  var progress = document.getElementById("progress");
  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      var h = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = "scaleX(" + (h > 0 ? Math.min(1, window.scrollY / h) : 0) + ")";
      ticking = false;
    });
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  if (reduce || !("IntersectionObserver" in window)) {
    entries.forEach(function (el) { el.classList.add("seen"); });
  } else {
    var io = new IntersectionObserver(function (rows) {
      rows.forEach(function (r) {
        if (r.isIntersecting) { r.target.classList.add("seen"); io.unobserve(r.target); }
      });
    }, { rootMargin: "0px 0px -8% 0px" });
    entries.forEach(function (el) { io.observe(el); });
    setTimeout(function () { entries.forEach(function (el) { el.classList.add("seen"); }); }, 2500);
  }

  if (!reduce) {
    var spines = document.querySelectorAll(".entries");
    spines.forEach(function (ul) { ul.style.setProperty("--spine", "0"); });
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        spines.forEach(function (ul) { ul.style.setProperty("--spine", "1"); });
      });
    });
  }
})();
</script>
</body>
</html>
